{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "transcript",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "workers_dev": true,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "transcript.kainzow.app", "custom_domain": true }
  ],
  // 20 token requests per minute per client IP. A token is only needed when a
  // session starts, so this throttles password guessing without affecting use.
  "unsafe": {
    "bindings": [
      { "name": "RATE_LIMITER", "type": "ratelimit", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } }
    ]
  }
  // Secrets (set with `npx wrangler secret put <NAME>`; locally in .dev.vars):
  //   DEEPGRAM_API_KEY  required - Deepgram key with Member permissions
  //   APP_PASSWORD      optional - if set, the browser must supply it to get a token
}
